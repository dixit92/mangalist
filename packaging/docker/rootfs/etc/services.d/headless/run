#!/bin/sh
# The MangaList headless runner (scheduled rescans; downloads opt-in), next to the GUI.
# Runs as USER_ID / GROUP_ID; respawned if it exits. MANGALIST_HEADLESS=0 disables it.
set -u
cd /config || exit 1

/opt/mangalist/venv/bin/python -m mangalist --headless &
pid=$!
stopping=0
trap 'stopping=1; kill -TERM "$pid" 2>/dev/null' TERM INT

rc=0
wait "$pid" || rc=$?
# A trapped signal interrupts wait; wait again for the runner's real exit status.
while kill -0 "$pid" 2>/dev/null; do
    rc=0
    wait "$pid" || rc=$?
done

if [ "$stopping" -eq 0 ] && [ "$rc" -ne 0 ]; then
    # A bad setting or a crash: do not respawn in a tight loop.
    echo "headless runner exited with status $rc; restarting in 60 s"
    sleep 60 &
    wait $! || true
fi
exit "$rc"
